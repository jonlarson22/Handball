{
  "rules": {
    "players": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() in ['owner', 'admin']"
    },
    "pending": {
      ".read": true,
      ".write": true
    },
    "history": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() in ['owner', 'admin']"
    },
    "tournaments": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() in ['owner', 'admin', 'director']"
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (!root.child('admins').exists() || root.child('admins').child(auth.uid).child('role').val() == 'owner')"
    },
    "adminRequests": {
      ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'owner')",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).child('role').val() == 'owner')"
      }
    }
  }
}
